<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dir_titulo"
            android:textColor="@color/rojo"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvActual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/gris"
            android:textSize="15sp" />

        <ImageView
            android:id="@+id/imgMapa"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="16dp"
            android:contentDescription="@string/desc_mapa"
            android:scaleType="centerCrop"
            android:src="@drawable/img_mapa" />

        <EditText
            android:id="@+id/etDireccion"
            style="@style/Campo"
            android:layout_marginTop="16dp"
            android:autofillHints="postalAddress"
            android:hint="@string/hint_direccion"
            android:inputType="textPostalAddress" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnNuevo"
                style="@style/BotonSecundario"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/btn_nuevo" />

            <Button
                android:id="@+id/btnListo"
                style="@style/BotonPrincipal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/btn_listo" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
